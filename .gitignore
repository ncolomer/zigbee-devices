# PlatformIO
.pio/
.cache/

# VSCode
.vscode/

# Node.js (Z2M external converters)
node_modules/

# macOS
.DS_Store
.claude/
*.zip

# Local MCP server config (machine-specific server paths/setup, not shared)
.mcp.json

# KiCad build artifacts / backups
*.dsn
*.ses
~*.lck
*-backups/
.history/

# KiCad fabrication/assembly exports (regenerate via Konnect export_manufacturing_package
# and/or kicad-jlcpcb-tools; not source, don't track)
**/hardware/fab_export/
**/hardware/jlcpcb/

# KiCad scratch/calibration project files (temporary test boards, not the real design)
**/hardware/*-calib.kicad_pro
**/hardware/*-calib.kicad_prl
**/hardware/*-test3d.kicad_pro
**/hardware/*-test3d.kicad_prl
