{
  "mcpServers": {
    "konnect": {
      "type": "stdio",
      "command": "${HOME}/Documents/KiCad/10.0/3rdparty/plugins/com_github_mixelpixx_konnect/bin/konnect",
      "args": [
        "--config",
        "${HOME}/Library/Application Support/konnect/konnect-settings.json"
      ],
      "env": {}
    },
    "freerouting-mcp": {
      "command": "java",
      "args": [
        "-jar",
        "${HOME}/Applications/Freerouting/freerouting-2.4.1.jar",
        "--api_server.enabled=true",
        "--api_server.authentication.enabled=false",
        "--mcp_server.enabled=true",
        "--mcp_server.authentication.enabled=false",
        "--mcp_server.stdio=true",
        "--gui.enabled=false"
      ]
    }
  }
}
